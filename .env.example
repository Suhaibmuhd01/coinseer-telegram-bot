# ==========================================
# CoinSeer Platform Environment Configuration
# ==========================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain-or-ngrok.ngrok-free.app/webhook
TELEGRAM_WEBHOOK_SECRET=a_random_cryptographic_secret_string_32chars
TELEGRAM_WEBAPP_URL=https://your-domain-or-ngrok.ngrok-free.app/webapp

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL AsyncPG)
DATABASE_URL=postgresql+asyncpg://coinseer_user:coinseer_secret_pass@db:5432/coinseer_db
# If running locally outside Podman/Docker:
# DATABASE_URL=postgresql+asyncpg://coinseer_user:coinseer_secret_pass@localhost:5432/coinseer_db

# Redis Configuration (Cache, PubSub, Rate-Limiter & ARQ)
REDIS_URL=redis://redis:6379/0
# If running locally outside Podman/Docker:
# REDIS_URL=redis://localhost:6379/0

# External Market Data & Intelligence APIs
COINGECKO_API_KEY=
COINGECKO_IS_PRO=false
COINMARKETCAP_API_KEY=
CRYPTOPANIC_API_KEY=
NEWS_API_KEY=

# Google AI Studio / Gemini API (For /ai_brief)
GEMINI_API_KEY=

# Monitoring & APM (Optional)
SENTRY_DSN=
